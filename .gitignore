# ============================================
# CampusHire - .gitignore
# ============================================

# --- Secrets & Environment ---
.env
*.env
.env.*
secrets.json
backend/.env

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
backend/venv/

# --- Frontend Dependencies & Build ---
frontend/node_modules/
frontend/dist/
node_modules/

# --- IDE ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.DS_Store

# --- Database ---
*.sqlite3
*.db

# --- Test / Temp files ---
emails.md
fix_bundle.py
*.log
